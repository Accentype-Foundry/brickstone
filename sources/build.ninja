# Postprocessing  with BuildSTAT
build $
    /var/folders/k0/tp0d5g7n5zdbf8sycx0wwjhh0000gn/T/tmp0sl077mj.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/Brickstone[wght].ttf | $
    ../fonts/variable/Brickstone[wght].ttf
  stamp =  && touch $
      /var/folders/k0/tp0d5g7n5zdbf8sycx0wwjhh0000gn/T/tmp0sl077mj.buildStatstamp
  postprocess = buildStat
  args = --src /var/folders/k0/tp0d5g7n5zdbf8sycx0wwjhh0000gn/T/tmpnc8q3r25
